#include <zephyr/dt-bindings/adc/adc.h>

&hppass_analog0 {
	trig-in-1-type = <3>;
};

&adc0 {
	status = "okay";
	ref-internal-source;
	#address-cells = <1>;
	#size-cells = <0>;

	channel@d {
		reg = <13>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
		zephyr,input-positive = <13>;
	};
};

/ {
	zephyr,user {
		io-channels = <&adc0 13>;
	};

	mtb_stl: mtb_stl {
		compatible = "infineon,mtb-stl";
		status = "okay";

		dac_test: dac_hppass_test {
			csg = <&csg0>;
			dac-slice = <0>;
		};
	};
};
